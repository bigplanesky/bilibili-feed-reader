{
  "manifest_version": 3,
  "name": "B站动态已读助手",
  "version": "1.0.1",
  "description": "展开评论或打开动态、视频后记为已读，按时间筛选并隐藏已读动态。数据仅保存在本机。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://t.bilibili.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://t.bilibili.com/*"],
      "js": ["core.js", "adapter.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
